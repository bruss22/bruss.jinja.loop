{# Script #1: Import CLI template For FMG. Create new Jinja CLI Template with the following contents#}
{# Nets Object is list of dictionaries containing Network Based MetaVariables #}
{# MetaVars should be in place om FMG prior to template creation #}
{# format key:metavar #}
{#'subnet':network1_subnet define in cidr notation xxx.xxx.xxx.xxx/xx. script checks for host and network#}
{# 'netid':network1_netid will be used for VLANID / DHCP Server Index or both #}
{#Script1 Import file 00-import for build scripts. Build script will loop through list of dictionaries calling keys to render configs. #}
{%- set _do = "" -%}
{%- set vars = {} -%}
{# Glabal Vars, If vlan based networks set network type to "network_type":"vlan" #}
{%- set _do = vars.update({
  "network_type":"vlan",
})-%} 
{%- set nets = 
  [
        {'name':network1_name, 'port':network1_port, 'netid':network1_netid, 'subnet':network1_subnet, 'dhcp':network1_dhcp, 'vrf':network1_vrf},
        {'name':network2_name, 'port':network2_port, 'netid':network2_netid, 'subnet':network2_subnet, 'dhcp':network2_dhcp, 'vrf':network2_vrf},
  ]
-%}
